# Normalize every text file to LF in the repository and in the working tree,
# so Windows/WSL checkouts of the same clone never produce phantom diffs.
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
