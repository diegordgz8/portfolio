---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Image from 'astro/components/Image.astro';
import Button from '../../components/Button.astro';
import { Icon } from 'astro-icon/components';

import profilePicture from '../../assets/img/profile-pic.webp';
import contactCover from '../../assets/img/developing.jpg';
import JobCard from '../../components/JobCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SkillsBento from '../../components/SkillsBento.astro';
import { languages, type Lang } from '../../i18n/ui';
import { getLocalizedCollection, langParam, useTranslations } from '../../i18n/utils';

export const getStaticPaths = (() =>
    (Object.keys(languages) as Lang[]).map((lang) => ({
        params: { lang: langParam(lang) },
        props: { lang },
    }))) satisfies GetStaticPaths;

const { lang } = Astro.props;
const t = useTranslations(lang);

const jobs = (await getLocalizedCollection('jobs', lang)).map(({ entry }) => entry);
jobs.sort((a, b) => {
    const dateA = new Date(a.data.dateFrom).getTime();
    const dateB = new Date(b.data.dateFrom).getTime();

    return dateB - dateA;
});

const projectOrder = ['sgcweb', 'gerardi', 'portfolio', 'bonsai'];
const projects = (await getLocalizedCollection('projects', lang)).sort(
    (a, b) => projectOrder.indexOf(a.slug) - projectOrder.indexOf(b.slug),
);
---

<Layout title={t('meta.title')} description={t('meta.description')}>
    <section id="hero">
        <div
            class="relative container flex items-center justify-center px-8 sm:px-8 sm:py-28 md:px-12 md:pt-30 lg:h-screen lg:justify-start lg:py-0"
        >
            <div
                id="hero-ring"
                class="bg-ring fixed -top-20 right-0 -z-50 aspect-square h-auto w-full -rotate-90 transition-opacity duration-500 lg:top-0 lg:h-full lg:w-auto lg:rotate-0"
            >
            </div>

            <div
                class="flex max-w-250 flex-col items-center justify-center gap-x-8 gap-y-8 lg:items-start lg:gap-y-12"
            >
                <div class="relative w-40 md:w-52 2xl:w-72">
                    <div
                        class="ring-brand dark:ring-brand-dark ring-offset-surface-500 dark:ring-offset-surface-dark-500 absolute inset-0 rounded-full ring-6 ring-offset-16 blur-md"
                    >
                    </div>
                    <Image
                        class={'relative w-full rounded-full shadow hover:scale-110 transition duration-300 ring-4 ring-offset-16 ring-brand/10 hover:ring-brand/50 dark:ring-brand-dark/10 dark:hover:ring-brand-dark/60 ring-offset-surface-500 dark:ring-offset-surface-dark-500 ease-in-out'}
                        src={profilePicture}
                        alt={t('hero.portraitAlt')}
                    />
                </div>

                <div class="flex flex-col items-center gap-2 lg:items-start">
                    <h1 class="text-xl font-semibold uppercase sm:text-2xl lg:text-4xl">
                        Diego A. Rodríguez
                    </h1>
                    <p
                        class="text-primary-500 text-center text-xl font-bold sm:text-3xl lg:text-left lg:text-4xl xl:text-5xl dark:text-teal-500"
                    >
                        {t('hero.tagline')}
                    </p>
                    <div
                        class="text-muted-500 dark:text-surface-600 flex flex-col gap-2 lg:text-xl"
                    >
                        <p>{t('hero.intro')}</p>
                    </div>
                    <div
                        class="mt-4 flex h-full w-full flex-col items-stretch justify-between gap-4 text-xl sm:w-auto sm:flex-row sm:items-center"
                    >
                        <Button href="#portfolio" class="btn-solid">
                            <Icon name="mdi:briefcase" class="h-6 w-6" />
                            {t('hero.viewProjects')}
                        </Button>

                        <Button href={t('hero.cvFile')} target="_blank" class="btn-outline">
                            <Icon name="mdi:download" class="h-6 w-6" />
                            {t('hero.downloadCv')}
                        </Button>
                    </div>
                    <div class="mt-4 flex h-full items-center justify-between gap-4 text-xl">
                        <a href="https://github.com/diegordgz8" target="_blank">
                            <Icon name="mdi:github" class="h-12 w-12 text-black dark:text-white" />
                        </a>
                        <a href="https://linkedin.com/in/diegordgz8" target="_blank">
                            <Icon name="mdi:linkedin" class="h-12 w-12 text-[#0A66C2]" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="jobs">
        <div class="container py-12 sm:px-4 md:px-8 lg:py-16 xl:px-12">
            <h2 class="section-title">{t('section.jobs')}</h2>
            <div class="grid gap-x-8 gap-y-12 xl:grid-cols-1">
                {jobs.map((job) => <JobCard {...job.data} />)}
            </div>
        </div>
    </section>

    <section id="portfolio">
        <!-- Works (incluir los proyectos que he hecho. Recomendable copiar una web existente. No colocar más de 10 trabajos y escoger los mejores y más llamativos) -->
        <div class="container py-12 sm:px-4 md:px-8 lg:py-16 xl:px-12">
            <h2 class="section-title">{t('section.portfolio')}</h2>
            <div class="grid gap-x-8 gap-y-12 xl:grid-cols-2">
                {
                    projects.map(({ entry, slug }) => (
                        <ProjectCard slug={slug} lang={lang} {...entry.data} />
                    ))
                }
            </div>
        </div>
    </section>

    <section id="skills">
        <div class="container py-12 sm:px-4 md:px-8 lg:py-16 xl:px-12">
            <h2 class="section-title">{t('section.skills')}</h2>
            <SkillsBento lang={lang} />
        </div>
    </section>

    <section id="contact">
        <div class="container py-12 sm:px-4 md:px-8 lg:py-16 xl:px-12">
            <h2 class="section-title">{t('section.contact')}</h2>
            <div class="grid gap-8 md:grid-cols-2">
                <div class="flex flex-col gap-6">
                    <p class="text-muted-500 dark:text-surface-600 text-lg">
                        {t('contact.pitch')}
                    </p>
                    <div class="flex flex-col gap-4">
                        <a
                            href="https://wa.me/584245458256"
                            target="_blank"
                            class="flex items-center gap-3 rounded-xl bg-green-800 px-4 py-4 text-white transition-colors hover:bg-green-700 md:px-6"
                        >
                            <Icon name="mdi:whatsapp" class="h-6 w-6" />
                            <span class="font-semibold">+58 424 545 8256</span>
                        </a>
                        <a
                            href="https://linkedin.com/in/diegordgz8"
                            target="_blank"
                            class="flex items-center gap-3 rounded-xl bg-[#0A66C2] px-4 py-4 text-white transition-colors hover:bg-[#004182] md:px-6"
                        >
                            <Icon name="mdi:linkedin" class="h-6 w-6" />
                            <span class="font-semibold">LinkedIn</span>
                        </a>
                        <a
                            href="https://github.com/diegordgz8"
                            target="_blank"
                            class="bg-surface-dark-400 hover:bg-surface-dark-300 flex items-center gap-3 rounded-xl px-4 py-4 text-white transition-colors md:px-6"
                        >
                            <Icon name="mdi:github" class="h-6 w-6" />
                            <span class="font-semibold">GitHub</span>
                        </a>
                    </div>
                </div>
                <div class="flex items-center justify-center">
                    <Image
                        class="aspect-[2.4/1] w-full rounded-lg object-cover"
                        src={contactCover}
                        alt={t('contact.imageAlt')}
                    />
                </div>
            </div>
        </div>
    </section>

    <script>
        const setupRingObserver = () => {
            const jobs = document.getElementById('jobs');
            const ring = document.getElementById('hero-ring');

            if (jobs && ring) {
                const updateRing = () => {
                    const isAboveJobs = jobs.getBoundingClientRect().top > 0;
                    ring.style.opacity = isAboveJobs ? '1' : '0';
                };

                updateRing();

                const observer = new IntersectionObserver(
                    ([entry]) => {
                        const isAboveJobs = jobs.getBoundingClientRect().top > 0;
                        ring.style.opacity = !entry.isIntersecting && isAboveJobs ? '1' : '0';
                    },
                    { rootMargin: '0px 0px -30% 0px' },
                );

                observer.observe(jobs);
            }
        };

        setupRingObserver();
        document.addEventListener('astro:after-swap', setupRingObserver);
    </script>
</Layout>
