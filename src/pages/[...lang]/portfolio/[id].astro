---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { Icon } from 'astro-icon/components';
import { languages, type Lang } from '../../../i18n/ui';
import {
    getLocalizedCollection,
    langParam,
    localizePath,
    useTranslations,
} from '../../../i18n/utils';

export async function getStaticPaths() {
    const paths = await Promise.all(
        (Object.keys(languages) as Lang[]).map(async (lang) =>
            (await getLocalizedCollection('projects', lang)).map(({ entry, slug }) => ({
                params: { lang: langParam(lang), id: slug },
                props: { project: entry, slug, lang },
            })),
        ),
    );

    return paths.flat();
}

const { project, slug, lang } = Astro.props;
const { data } = project;
const t = useTranslations(lang);
const { name, description, cover, stack, link, pictures } = data;

const { Content } = await render(project);
const ogCover = cover ? (await getImage({ src: cover })).src : undefined;
---

<Layout title={`${name} - ${t('project.titleSuffix')}`} description={description} image={ogCover}>
    <div class="container mt-4 flex flex-col justify-between gap-4 sm:flex-row lg:mt-20">
        <Button class="btn-outline" href={localizePath('/#portfolio', lang)}>
            <Icon name="mdi:arrow-left" class="h-6 w-6" />
            {t('project.back')}
        </Button>

        {
            link && (
                <Button class="btn-solid" href={`${link}`} target="_blank">
                    {t('project.view')}
                    <Icon name="mdi:link" class="h-6 w-6" />
                </Button>
            )
        }
    </div>

    <div class="container flex flex-col gap-10 py-12 xl:flex-row">
        <aside class="flex w-full flex-col gap-4">
            {
                cover && (
                    <Image
                        class="aspect-video rounded-lg object-cover object-top"
                        src={cover}
                        alt={name}
                        transition:name={`img-${slug}`}
                        data-lightbox
                    />
                )
            }
            {
                pictures && pictures.length > 0 && (
                    <div class="grid grid-cols-2 gap-4">
                        {pictures.map((pic, i) => (
                            <Image
                                class="aspect-video rounded-lg object-cover object-top"
                                src={pic}
                                alt={`${name} - ${t('project.screenshot')} ${i + 1}`}
                                data-lightbox
                            />
                        ))}
                    </div>
                )
            }
        </aside>

        <main class="w-full">
            <h1
                class="text-primary-500 text-center text-4xl font-semibold lg:text-left lg:text-6xl dark:text-teal-500"
            >
                {name}
            </h1>

            <div class="mt-4 flex flex-wrap justify-center gap-2 font-bold lg:justify-start">
                {
                    stack.map((item) => (
                        <span class="bg-muted-500 rounded-full px-4 py-2 text-sm text-white">
                            {item}
                        </span>
                    ))
                }
            </div>

            <div
                class="prose dark:prose-invert prose-headings:text-center lg:prose-headings:text-left mt-8 lg:mt-4"
            >
                <Content />
            </div>
        </main>
    </div>

    <Lightbox />
</Layout>
