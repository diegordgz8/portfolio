---
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const VERIFY_URL = 'https://englishscore.com/verify';
const VERIFY_CODE = 'd07acaef2125';
const SCORE = 537;
const MAX_SCORE = 600;

const scores = [
    { label: t('cert.grammar'), value: 510 },
    { label: t('cert.vocabulary'), value: 541 },
    { label: t('cert.reading'), value: 548 },
    { label: t('cert.listening'), value: 548 },
];
---

<div
    class="bg-primary-500 text-surface-500 dark:bg-muted-800 dark:text-surface-400 flex flex-col items-center gap-8 rounded-2xl p-6 md:p-8 lg:flex-row lg:gap-10"
>
    <div class="flex shrink-0 flex-col items-center gap-2">
        <svg viewBox="0 0 116 124" class="h-28 w-26" role="img">
            <title>{`${SCORE} / ${MAX_SCORE}`}</title>
            <path d="M58 4 108 20v48c0 30-22 45-50 52C30 113 8 98 8 68V20z" fill="#0f9b8e"></path>
            <text
                x="58"
                y="76"
                text-anchor="middle"
                font-size="42"
                font-weight="700"
                fill="#ffffff"
                font-family="inherit">{SCORE}</text
            >
        </svg>
        <span class="text-sm opacity-70">{t('cert.scoreOf')}</span>
    </div>

    <div class="flex flex-1 flex-col items-center gap-3 lg:items-start">
        <div class="flex flex-col items-center gap-3 sm:flex-row">
            <h3 class="text-2xl font-bold">EnglishScore Core Skills</h3>
            <span class="rounded-full bg-teal-500 px-4 py-1 text-sm font-bold text-teal-900">
                CEFR C1 · Advanced
            </span>
        </div>

        <p class="text-center opacity-70 lg:text-left">{t('cert.issuer')}</p>

        <dl class="mt-2 grid w-full grid-cols-2 gap-4 sm:grid-cols-4">
            {
                scores.map((score) => (
                    <div class="flex flex-col gap-1">
                        <dt class="text-xs opacity-70">{score.label}</dt>
                        <dd class="m-0 text-lg font-bold text-teal-400">{score.value}</dd>
                    </div>
                ))
            }
        </dl>
    </div>

    <div class="flex w-full shrink-0 flex-col items-center gap-3 lg:w-auto">
        <Button
            class="btn-solid w-full px-4! text-base! whitespace-nowrap"
            href={VERIFY_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-certificate-verify
        >
            {t('cert.verify')}
            <Icon name="mdi:open-in-new" class="h-5 w-5" />
        </Button>
        <div class="flex flex-col items-center gap-1">
            <span class="text-xs opacity-70">{t('cert.codeLabel')}</span>
            <button
                type="button"
                class="text-surface-500 dark:text-surface-300 flex cursor-pointer items-center gap-2 rounded-lg px-2 py-1 text-sm font-bold transition hover:bg-black/10 dark:hover:bg-white/10"
                title={t('cert.copyCode')}
                aria-label={`${t('cert.copyCode')}: ${VERIFY_CODE}`}
                data-certificate-code={VERIFY_CODE}
                data-copied-label={t('cert.codeCopied')}
            >
                {VERIFY_CODE}
                <span data-copy-idle><Icon name="mdi:content-copy" class="h-4 w-4" /></span>
                <span data-copy-done class="hidden">
                    <Icon name="mdi:check" class="h-4 w-4 text-teal-400" />
                </span>
            </button>
            <span class="sr-only" role="status" data-copy-status></span>
        </div>
    </div>
</div>

<script>
    // Bundled scripts run once per session, so one delegated listener covers
    // every page reached through View Transitions.
    document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('[data-certificate-verify]');
        if (!link) return;

        const w = window as Window & { dataLayer?: object[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
            event: 'certificate_verify',
            page_language: document.documentElement.lang,
        });
    });

    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    async function copyText(text: string) {
        if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
            return;
        }

        // Fallback for browsers without the async clipboard API (or insecure origins).
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
    }

    document.addEventListener('click', async (e) => {
        const button = (e.target as HTMLElement).closest<HTMLElement>('[data-certificate-code]');
        if (!button) return;

        const code = button.dataset.certificateCode;
        if (!code) return;

        try {
            await copyText(code);
        } catch {
            return;
        }

        const idle = button.querySelector('[data-copy-idle]');
        const done = button.querySelector('[data-copy-done]');
        const status = button.parentElement?.querySelector('[data-copy-status]');

        idle?.classList.add('hidden');
        done?.classList.remove('hidden');
        if (status) status.textContent = button.dataset.copiedLabel ?? '';

        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
            idle?.classList.remove('hidden');
            done?.classList.add('hidden');
            if (status) status.textContent = '';
        }, 2000);

        const w = window as Window & { dataLayer?: object[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
            event: 'certificate_code_copy',
            page_language: document.documentElement.lang,
        });
    });
</script>
