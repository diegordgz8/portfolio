---
/* Loader for the GTM container. Rendered from Layout.astro only in production
   builds, so local development never reaches GA4 or Clarity. The companion
   <GoogleTagManagerNoscript /> goes at the top of <body>. */
---

<script is:inline>
    (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', 'GTM-MZZBZ8WR');
</script>
